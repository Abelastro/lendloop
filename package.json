{
  "name": "lendloop",
  "version": "1.0.0",
  "private": true,
  "description": "A neighborhood tool-lending board with signed n8n automations.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "node scripts/test-report.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:report && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm run workflows:validate && npm run test",
    "workflows:build": "node scripts/build-workflows.mjs && node scripts/build-cloud-workflows.mjs && prettier --write \"workflows/**/*.json\"",
    "workflows:validate": "node scripts/validate-workflows.mjs",
    "n8n:up": "docker compose -f docker-compose.n8n.yml up -d",
    "n8n:down": "docker compose -f docker-compose.n8n.yml down",
    "n8n:logs": "docker compose -f docker-compose.n8n.yml logs -f n8n",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.24",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@vercel/otel": "^2.3.0",
    "clsx": "2.1.1",
    "convex": "1.49.0",
    "geist": "1.9.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "^3.27.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "convex-test": "^0.0.67",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
