# ---------------------------------------------------------------------------
# LendLoop n8n / Postgres environment template
# Copy to n8n.env (ignored by git), then fill every value.
# Generate secrets with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# Postgres container
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
POSTGRES_DB=n8n

# n8n database connection (same password as POSTGRES_PASSWORD)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=replace_with_openssl_rand_hex_32
DB_POSTGRESDB_SCHEMA=public

# n8n runtime
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Convex deployment HTTP endpoint, no trailing slash:
# https://your-deployment.convex.site
LENDLOOP_CONVEX_SITE_URL=https://your-deployment.convex.site

# Must equal Convex N8N_OUTBOUND_SECRET. Verifies Convex -> n8n requests.
LENDLOOP_INBOUND_SECRET=replace_with_openssl_rand_hex_32

# Must equal Convex N8N_INBOUND_SECRET. Signs n8n -> Convex requests.
LENDLOOP_OUTBOUND_SECRET=replace_with_openssl_rand_hex_32

# Optional shared Slack webhook for local automation demos.
LENDLOOP_SLACK_WEBHOOK_URL=

# Optional per-recipient email delivery through Resend. When both values are
# set and Convex has NOTIFICATION_ROUTING=email, workflows email the borrower
# or lender instead of posting to the shared Slack channel.
LENDLOOP_RESEND_API_KEY=
LENDLOOP_NOTIFICATION_FROM_EMAIL=
