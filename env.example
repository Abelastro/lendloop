# ---------------------------------------------------------------------------
# LendLoop environment template
# Copy to .env.local for the Next.js app. Never commit real values.
# Convex-only variables are set with `npx convex env set NAME value`.
# ---------------------------------------------------------------------------

# Canonical app URL used for metadata and Open Graph images.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional redirects. These are the defaults Clerk uses when omitted.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Convex (https://dashboard.convex.dev -> Deployment settings)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ---------------------------------------------------------------------------
# Convex runtime variables (`npx convex env set ...`)
# --------------------------------------------------------------------------- 

# Clerk JWT issuer domain, used by convex/auth.config.ts (not a secret).
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Comma-separated Clerk email addresses elevated to the admin role on sign-in.
ADMIN_EMAILS=admin-email-here

# Public n8n webhook for request/status notifications. Leave unset to record
# automation events as "skipped" in local development.
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/lendloop/notifications

# Secret Convex uses to sign requests TO n8n. Must equal the n8n runtime
# variable LENDLOOP_INBOUND_SECRET.
N8N_OUTBOUND_SECRET=replace_with_openssl_rand_hex_32

# Secret Convex uses to verify requests FROM n8n. Must equal the n8n runtime
# variable LENDLOOP_OUTBOUND_SECRET.
N8N_INBOUND_SECRET=replace_with_openssl_rand_hex_32

# Notification routing. "email" includes the recipient email in signed n8n
# payloads so the workflow can use Resend; "slack" keeps the shared webhook;
# "mock" records a visible local delivery. Defaults to mock.
NOTIFICATION_ROUTING=mock

# Provider-neutral OpenTelemetry. Point this at an OTLP collector (Datadog,
# Honeycomb, Grafana, or a local collector). Leave unset to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lendloop-web
