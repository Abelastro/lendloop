        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.fromEmail, to: $json.recipientEmail, subject: $json.subject, text: $json.text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "f7a8b9c0-d1e2-4f3a-8b4c-5d6e7f8a9b0c",
