        "jsCode": "const prepared = $('Prepare reminder').item.json;\nreturn {\n  json: {\n    loanId: prepared.loanId,\n    date: prepared.date,\n    channel: 'email',\n    status: 'sent',\n    sentAt: Date.now(),\n    providerMessageId: $json.id ? String($json.id) : undefined,\n  },\n};"
