            },
            {
              "name": "x-lendloop-idempotency-key",
              "value": "={{ $json.headers['x-lendloop-idempotency-key'] }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      },
