{
  "id": "8c2d4e6f-1a3b-4c5d-8e7f-9a0b1c2d3e4f",
  "name": "LendLoop - Daily overdue reminders",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 14,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f",
      "name": "Daily at 14:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-820, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst key = $env[['LENDLOOP', 'OUTBOUND', 'SECRET'].join('_')];\nif (!key) throw new Error('LENDLOOP_OUTBOUND_SECRET is not configured');\nconst base = $env.LENDLOOP_CONVEX_SITE_URL;\nif (!base) throw new Error('LENDLOOP_CONVEX_SITE_URL is not configured');\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst signature = crypto.createHmac('sha256', key).update(timestamp + '.').digest('hex');\nreturn [\n  {\n    json: {\n      headers: {\n        'content-type': 'application/json',\n        'x-lendloop-timestamp': timestamp,\n        'x-lendloop-signature': signature,\n      },\n    },\n  },\n];"
      },
      "id": "d2e3f4a5-b6c7-4d8e-9f0a-1b2c3d4e5f6a",
      "name": "Sign overdue request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL + '/n8n/overdue' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "={{ $json.headers['content-type'] }}"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.headers['x-lendloop-timestamp'] }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.headers['x-lendloop-signature'] }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "e3f4a5b6-c7d8-4e9f-8a0b-1c2d3e4f5a6b",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst loans = Array.isArray(response.loans) ? response.loans : [];\nreturn loans.map((loan) => ({ json: { date: response.date, ...loan } }));"
      },
      "id": "f4a5b6c7-d8e9-4f0a-9b1c-2d3e4f5a6b7c",
      "name": "Expand loans",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const loan = $json;\nconst slackUrl = $env[['LENDLOOP', 'SLACK', 'WEBHOOK', 'URL'].join('_')];\nconst recipientEmail = String(loan.borrowerEmail ?? '');\nconst resendKey = $env[['LENDLOOP', 'RESEND', 'API', 'KEY'].join('_')];\nconst fromEmail = $env[['LENDLOOP', 'NOTIFICATION', 'FROM', 'EMAIL'].join('_')];\nconst canEmail = Boolean(recipientEmail && resendKey && fromEmail);\nconst channel = canEmail ? 'email' : slackUrl ? 'slack' : 'mock';\nconst subject = 'LendLoop overdue reminder: ' + loan.toolName;\nconst text = `Overdue reminder: ${loan.toolName} was due ${loan.endDate} (${loan.daysOverdue} day(s) ago). Borrowed by ${loan.borrowerName}. Please return it or update LendLoop.`;\nif (channel === 'mock') console.log('[mock reminder] ' + text);\nreturn {\n  json: {\n    ...loan,\n    text,\n    slackUrl: slackUrl || '',\n    recipientEmail,\n    fromEmail: fromEmail || '',\n    subject,\n    channel,\n  },\n};"
      },
      "id": "a5b6c7d8-e9f0-4a1b-8c2d-3e4f5a6b7c8d",
      "name": "Prepare reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b6c7d8e9-f0a1-4b2c-9d3e-4f5a6b7c8d9e",
              "leftValue": "={{ $json.slackUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c7d8e9f0-a1b2-4c3d-8e4f-5a6b7c8d9e0f",
      "name": "Slack configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.slackUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "d8e9f0a1-b2c3-4d4e-9f5a-6b7c8d9e0f1a",
      "name": "Post Slack reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, -120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prepared = $('Prepare reminder').item.json;\nreturn {\n  json: {\n    loanId: prepared.loanId,\n    date: prepared.date,\n    channel: 'slack',\n    status: 'sent',\n    sentAt: Date.now(),\n    providerMessageId: $json.message_id ? String($json.message_id) : undefined,\n  },\n};"
      },
      "id": "e9f0a1b2-c3d4-4e5f-8a6b-7c8d9e0f1a2b",
      "name": "Slack receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, -120]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prepared = $json;\nreturn {\n  json: {\n    loanId: prepared.loanId,\n    date: prepared.date,\n    channel: 'mock',\n    status: 'sent',\n    sentAt: Date.now(),\n    providerMessageId: 'mock-' + prepared.loanId + '-' + prepared.date,\n  },\n};"
      },
      "id": "f0a1b2c3-d4e5-4f6a-9b7c-8d9e0f1a2b3c",
      "name": "Mock receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 140]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst key = $env[['LENDLOOP', 'OUTBOUND', 'SECRET'].join('_')];\nif (!key) throw new Error('LENDLOOP_OUTBOUND_SECRET is not configured');\nconst rows = $input.all().map((item) => item.json);\nif (!rows.length) return [];\nconst reminders = rows.map((row) => ({\n  loanId: row.loanId,\n  channel: row.channel,\n  status: row.status,\n  sentAt: row.sentAt,\n  providerMessageId: row.providerMessageId || undefined,\n}));\nconst body = JSON.stringify({ reminders, date: rows[0].date || undefined });\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst signature = crypto.createHmac('sha256', key).update(timestamp + '.' + body).digest('hex');\nreturn [\n  {\n    json: {\n      body,\n      headers: {\n        'content-type': 'application/json',\n        'x-lendloop-timestamp': timestamp,\n        'x-lendloop-signature': signature,\n        'x-lendloop-idempotency-key': 'overdue-batch-' + (rows[0].date ?? 'unknown'),\n      },\n    },\n  },\n];"
      },
      "id": "a1b2c3d4-e5f6-4a7b-8c8d-9e0f1a2b3c4d",
      "name": "Sign reminder write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 0]
    },
    {
      "parameters": {
